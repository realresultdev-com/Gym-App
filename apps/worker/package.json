{
  "name": "@gym-app/worker",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply gym-management-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gym-management-db --remote",
    "db:seed:local": "wrangler d1 execute gym-management-db --local --file=./src/database/migrations/seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gym-app/shared-types": "*",
    "@gym-app/shared-validation": "*",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.114.0"
  },
  "private": true
}

