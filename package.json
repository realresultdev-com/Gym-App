{
  "name": "gym-management-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "npm run start --workspace=@gym-app/mobile",
    "mobile:android": "npm run android --workspace=@gym-app/mobile",
    "mobile:ios": "npm run ios --workspace=@gym-app/mobile",
    "mobile:web": "npm run web --workspace=@gym-app/mobile",
    "worker:dev": "npm run dev --workspace=@gym-app/worker",
    "worker:deploy": "npm run deploy --workspace=@gym-app/worker",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}
