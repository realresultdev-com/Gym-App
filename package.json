{
  "name": "gym-management-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run worker:dev\" \"npm run web:dev\"",
    "web:dev": "npm run dev --workspace=@gym-app/web",
    "web:build": "npm run build --workspace=@gym-app/web",
    "build:android": "cd apps/web && npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease bundleRelease && copy /y app\\build\\outputs\\bundle\\release\\app-release.aab ..\\..\\RealFit-release.aab && copy /y app\\build\\outputs\\apk\\release\\app-release.apk ..\\..\\RealFit-release.apk",
    "run:android": "cd apps/web && npm run build && npx cap sync android && npx cap run android",
    "android:bundle": "npm run playstore:build --workspace=@gym-app/web",
    "worker:dev": "npm run dev --workspace=@gym-app/worker",
    "worker:deploy": "npm run deploy --workspace=@gym-app/worker",
    "mobile:start": "npm run start --workspace=@gym-app/mobile",
    "db:migrate:local": "npm run db:migrate:local --workspace=@gym-app/worker",
    "db:migrate:remote": "npm run db:migrate:remote --workspace=@gym-app/worker",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.1",
    "wrangler": "^3.114.0"
  }
}
